{
  "name": "@madewithremy/sandbox",
  "version": "0.1.5",
  "description": "Command-and-control server for Remy dev sandboxes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mindstudio-ai/mindstudio-sandbox.git"
  },
  "type": "module",
  "bin": {
    "remy-sandbox": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint:fix": "prettier --write ./src",
    "prepare": "husky",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "http-proxy": "^1.18.1",
    "json5": "^2.2.3",
    "node-pty": "^1.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^25.0.0",
    "@types/ws": "^8.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "prettier": "^3.8.1",
    "prettier-plugin-curly": "^0.4.1",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.27.7": true,
    "fsevents@2.3.3": true
  }
}
